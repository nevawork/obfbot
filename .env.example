# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_PREFIX=/

# Database
DATABASE_URL=sqlite:///./obfbot.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@localhost/obfbot

# Bot Configuration
BOT_OWNER_ID=your_user_id
BOT_ADMIN_ROLE_ID=admin_role_id
BOT_PREMIUM_ROLE_ID=premium_role_id

# Processing
MAX_QUEUE_SIZE=500
MAX_CONCURRENT_JOBS=10
MAX_FILE_SIZE_MB=25
JOB_TIMEOUT_SECONDS=300
CLEANUP_INTERVAL_SECONDS=3600

# Obfuscation Defaults
DEFAULT_OBFUSCATION_LEVEL=5
MAX_OBFUSCATION_LEVEL=10

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600
PREMIUM_RATE_LIMIT_REQUESTS=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/obfbot.log

# API (for future extensions)
API_HOST=0.0.0.0
API_PORT=8000
API_ENABLED=false

# Storage
TEMP_DIR=./temp
OUTPUT_DIR=./output
BACKUP_DIR=./backups
